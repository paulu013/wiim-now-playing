# Copy to `.env` next to docker-compose.yml and fill in. The real .env is gitignored.
# These override anything set in the UI (see getConfig in server/lib/external.js), so the
# corresponding Settings fields can be left blank and secrets stay out of settings.json.

# --- WiiM device ---
# Point the server straight at the WiiM's UPnP descriptor URL to skip SSDP discovery
# (lets the server run on a different VLAN than the WiiM — unicast only).
# Find it with: curl http://<wiim-ip>:49152/description.xml   (LinkPlay is usually port 49152)
# Give the WiiM a DHCP reservation so this URL stays stable.
WIIM_LOCATION=http://<wiim-ip>:49152/description.xml

# --- Plex (optional) ---
PLEX_URL=http://<plex-host>:32400
PLEX_TOKEN=
PLEX_USERS=
PLEX_PLAYERS=

# --- Jellyfin (optional) ---
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USERS=
JELLYFIN_PLAYERS=

# wiim (default) or external — who wins when both the WiiM and a Plex/Jellyfin session play
EXTERNAL_PRIORITY=external
