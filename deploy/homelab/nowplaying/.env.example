# Copy to /opt/homelab/docker/nowplaying/.env on the host (gitignored). env overrides the UI,
# so leave the matching Settings fields blank and keep secrets out of settings.json.

TZ=Europe/Amsterdam

# WiiM: descriptor URL so the server skips SSDP and reaches it across VLANs (unicast).
# Find it: curl http://<wiim-ip>:49152/description.xml   (give the WiiM a DHCP reservation)
WIIM_LOCATION=http://<wiim-ip>:49152/description.xml

# Plex
PLEX_URL=http://<plex-host>:32400
PLEX_TOKEN=
PLEX_USERS=stan

# Jellyfin
JELLYFIN_URL=
JELLYFIN_API_KEY=

# wiim (default) or external
EXTERNAL_PRIORITY=external

# Reverse proxy: trust X-Forwarded-For so rate-limiting works and the express-rate-limit
# warning stops. Unset => trust private-range proxies (good behind Traefik). Or a hop count.
# TRUST_PROXY=loopback, linklocal, uniquelocal
