[Unit]
Description=WiiM Now Playing volume knob (HID -> WiiM volume/transport)
After=network-online.target
Wants=network-online.target

[Service]
# User is rewritten by install.sh for the configured KIOSK_USER. The user needs
# read access to /dev/input/event* — install.sh adds them to the "input" group.
User=pi
SupplementaryGroups=input
EnvironmentFile=/etc/wnp-kiosk.conf
ExecStart=/usr/bin/python3 /opt/wnp/volume-knob.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
